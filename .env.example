# =================================================================
# AGRISCAN PRO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env sebelum menjalankan di server lokal / cPanel
# =================================================================

# 1. Konfigurasi Database MySQL (Prisma ORM)
# Format cPanel: mysql://[CPANEL_USER]_[DB_USER]:[PASSWORD]@localhost:3306/[CPANEL_USER]_[DB_NAME]
# Format Lokal : mysql://root:password@localhost:3306/agriscan_pro
DATABASE_URL="mysql://username:password@localhost:3306/nama_database"

# 2. Konfigurasi Server & Passenger cPanel
# Catatan: Di cPanel, PORT otomatis ditentukan oleh Node.js Selector / Phusion Passenger
PORT=3000
NODE_ENV=production

# 3. Konfigurasi Publik Aplikasi Next.js
NEXT_PUBLIC_APP_NAME="AgriScan Pro"
NEXT_PUBLIC_APP_TAGLINE="Sistem Pendukung Keputusan Pertanian Cerdas untuk Ketahanan Pangan"
